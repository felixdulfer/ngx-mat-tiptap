{
  "name": "ngx-mat-tiptap",
  "version": "0.7.5",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:demo": "ng build demo",
    "build:lib": "ng build ngx-mat-tiptap && node -e \"const fs = require('fs'); const path = 'dist/ngx-mat-tiptap'; fs.writeFileSync(path + '/index.d.ts', 'export * from \\\"./types/felixdulfer-ngx-mat-tiptap\\\";\\n'); const pkg = JSON.parse(fs.readFileSync(path + '/package.json', 'utf8')); if (pkg.exports && pkg.exports['.']) { pkg.exports['.'].types = './index.d.ts'; delete pkg.typings; fs.writeFileSync(path + '/package.json', JSON.stringify(pkg, null, 2) + '\\n'); }\"",
    "build:lib:watch": "ng build ngx-mat-tiptap --watch",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "demo": "ng serve demo",
    "demo:build": "ng build demo",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.7",
    "@angular/cdk": "^22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/material": "^22.0.5",
    "@angular/platform-browser": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@angular/router": "22.0.7",
    "@tiptap/core": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/prismjs": "^1.26.5",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.1",
    "prettier": "^3.9.5",
    "puppeteer": "^25.3.0",
    "semantic-release": "^25.0.7",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "zone.js": "^0.16.0"
  }
}
